rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    /*
     * A suspended moderator loses their powers until restored — otherwise
     * a suspension would stop them playing but not moderating, and they
     * could even lift their own suspension.
     */
    function isModerator() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/moderators/$(request.auth.uid)
        )
        && notSuspended(request.auth.uid);
    }

    /*
     * Site owners are moderators whose moderators/{uid} document has
     * owner: true. That field can only be set in the Firebase console
     * (see the moderators collection below), and only owners can make
     * or remove moderators.
     */
    function isSiteOwnerAccount(userId) {
      return exists(
          /databases/$(database)/documents/moderators/$(userId)
        )
        && get(
          /databases/$(database)/documents/moderators/$(userId)
        ).data.get('owner', false) == true;
    }

    function isSiteOwner() {
      return isModerator() && isSiteOwnerAccount(request.auth.uid);
    }

    /*
     * A suspension is a document in suspensions/{uid}, which only a
     * moderator can create or remove (see that collection below).
     * Every rule that lets a player write their own data checks this, so
     * a suspended account can still sign in and read but can no longer
     * earn or spend tokens, play, post scores or change its profile —
     * even with the UI bypassed. Restoring the account is deleting that
     * one document; nothing else needs to change.
     */
    function notSuspended(userId) {
      return !exists(
        /databases/$(database)/documents/suspensions/$(userId)
      );
    }

    function validUsername(username) {
      return username is string
        && username.size() >= 3
        && username.size() <= 20
        && username.matches('^[a-z0-9_]+$');
    }

    /*
     * email is optional and only ever the account's own Auth email,
     * written by AuthContext on sign-in. It exists so the Admin dashboard
     * can show and search by it: emails live in Firebase Authentication,
     * which no client can read for another user, so without a copy here
     * a moderator has no way to find somebody by email.
     *
     * users/{uid} is readable only by its owner or a moderator (below),
     * so this does not expose addresses to anyone else.
     *
     * lastSeenAt is optional too: AuthContext stamps it whenever the
     * account opens the site, for the Admin dashboard's "Last seen" column.
     * Its value is checked where it is written (create and update below)
     * so it can only ever be the server's current time.
     */
    function validProfile(profile) {
      return profile.keys().hasOnly([
          'username',
          'photoURL',
          'email',
          'lastSeenAt',
          'createdAt',
          'updatedAt'
        ])
        && validUsername(profile.username)
        && profile.photoURL is string
        && profile.photoURL.size() <= 2000
        && (
          !profile.keys().hasAny(['email'])
          || (
            profile.email is string
            && profile.email.size() <= 320
          )
        );
    }

    /*
     * Reading rewards are the only way a client can mint tokens, and the
     * document ID doubles as the article ID — a value the caller picks
     * freely. Unbounded, a script can invent article IDs ("free_money",
     * "99999", ...) and drive each invented read to payout; the 15-second
     * heartbeat spacing slows one read to four minutes but hundreds can
     * run at once.
     *
     * Restricting the ID to 1-1000 caps what anyone can ever earn, because
     * each article's reward document can only be created once. It needs
     * no upkeep: nothing has to change here until article 1001, and an ID
     * outside the range simply never pays. Invented IDs inside the range
     * still pay, but only one every three minutes (claimsRewardCooldown),
     * so farming them all would take a script days.
     */
    function validArticleId(articleId) {
      return articleId.matches('^[1-9][0-9]{0,2}$')
        || articleId == '1000';
    }

    /*
     * Every way of earning tokens needs a verified email, so a throwaway
     * account can't collect the sign-up bonus and every article reward.
     * Google sign-ins arrive verified; password accounts verify through
     * the link Signup.tsx emails them (or the article page resends).
     */
    function emailVerified() {
      return request.auth.token.email_verified == true;
    }

    /*
     * Article rewards come at most one every three minutes. Each reward
     * has to restamp users/{uid}/rewardCooldown/latest with its own
     * article ID and the current time, and that document's rule (below)
     * refuses a restamp sooner than three minutes after the last one.
     *
     * Without this a script could "read" every article in parallel and
     * collect them all in four minutes. Now that takes about two hours,
     * while someone reading one article after another never notices:
     * finishing an article takes 3m45s of heartbeats on its own. The
     * article ID ties the stamp to one reward, so a single write can't
     * cover several.
     */
    function claimsRewardCooldown(userId, articleId) {
      return getAfter(
          /databases/$(database)/documents/users/$(userId)/rewardCooldown/latest
        ).data.articleId == articleId
        && getAfter(
          /databases/$(database)/documents/users/$(userId)/rewardCooldown/latest
        ).data.rewardedAt == request.time;
    }

    function validRewardCooldown(cooldown) {
      return cooldown.keys().hasAll(['articleId', 'rewardedAt'])
        && cooldown.keys().hasOnly(['articleId', 'rewardedAt'])
        && cooldown.articleId is string
        && cooldown.rewardedAt == request.time;
    }

    function validProgress(progress, articleId) {
      return progress.keys().hasAll([
          'articleId',
          'activeSeconds',
          'rewarded',
          'lastHeartbeatAt',
          'rewardedAt'
        ])
        && progress.keys().hasOnly([
          'articleId',
          'activeSeconds',
          'rewarded',
          'lastHeartbeatAt',
          'rewardedAt'
        ])
        && progress.articleId is string
        && progress.articleId == articleId
        && progress.activeSeconds is int
        && progress.activeSeconds >= 15
        && progress.activeSeconds <= 240
        && progress.rewarded is bool
        && progress.lastHeartbeatAt is timestamp
        && (
          progress.rewardedAt == null
          || progress.rewardedAt is timestamp
        );
    }

    match /moderators/{moderatorId} {
      // Anyone may check their own status (AuthContext watches it to
      // show the Admin link); moderators may see the whole team so the
      // dashboard can badge them.
      allow get: if (signedIn() && request.auth.uid == moderatorId)
        || isModerator();

      allow list: if isModerator();

      // Only a site owner can make someone a moderator, and only an
      // existing account in good standing. The field list leaves out
      // `owner`, so owner status can never be granted from the site —
      // only in the Firebase console.
      allow create: if isSiteOwner()
        && exists(/databases/$(database)/documents/users/$(moderatorId))
        && notSuspended(moderatorId)
        && request.resource.data.keys().hasOnly(['addedBy', 'addedAt'])
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.addedAt == request.time;

      allow update: if false;

      // Owners can remove moderators, but never an owner (themselves
      // included) — that also stays a console-only change.
      allow delete: if isSiteOwner()
        && moderatorId != request.auth.uid
        && resource.data.get('owner', false) != true;
    }

    // Account suspensions, managed from the Admin dashboard. The owner may
    // read their own (AuthContext watches it to show the "suspended"
    // screen); only moderators may list, suspend or restore. A suspension
    // is never edited in place — restoring deletes it, and suspending
    // again creates a fresh one with a new reason.
    match /suspensions/{userId} {
      allow get: if isOwner(userId) || isModerator();
      allow list: if isModerator();

      // A moderator cannot suspend themselves, so nobody can lock
      // themselves out of the dashboard by accident, and nobody can
      // suspend a site owner — since suspension strips moderator powers,
      // that would let one moderator lock the owners out.
      allow create: if isModerator()
        && userId != request.auth.uid
        && !isSiteOwnerAccount(userId)
        && request.resource.data.keys().hasOnly([
          'reason',
          'moderatorUid',
          'createdAt'
        ])
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3
        && request.resource.data.reason.size() <= 200
        && request.resource.data.moderatorUid == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if false;

      allow delete: if isModerator();
    }

    match /users/{userId} {
      // Only the owner or a moderator may read a profile — the app never
      // needs to read another user's profile otherwise (Profile.tsx reads
      // its own doc; Mod.tsx lists everyone but is moderator-only). This
      // used to be `allow read: if true`, which let anyone, including
      // signed-out visitors, list and scrape every user's username and
      // profile photo.
      allow get, list: if isOwner(userId) || isModerator();

      allow create: if isOwner(userId)
        && notSuspended(userId)
        && validProfile(request.resource.data)
        && request.resource.data.get('lastSeenAt', request.time)
          == request.time;

      // lastSeenAt may be left alone or removed, but never set to
      // anything other than now, so nobody can fake when they were on.
      allow update: if isOwner(userId)
        && notSuspended(userId)
        && validProfile(request.resource.data)
        && (
          !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['lastSeenAt'])
          || request.resource.data.get('lastSeenAt', request.time)
            == request.time
        );

      allow delete: if isOwner(userId)
        && notSuspended(userId);
    }

    match /usernames/{username} {
      // Availability checks only ever `get()` one exact username, never
      // list the collection, so `list` can be closed without touching
      // that flow — it previously let anyone dump the full
      // username -> uid directory.
      allow get: if true;
      allow list: if false;

      /*
       * email is optional here and exists purely so somebody can log in
       * with their username: Firebase Auth only authenticates by email,
       * and a signed-out visitor can read nothing else — users/{uid} is
       * owner-or-moderator only. This document is the one thing readable
       * before anyone is signed in.
       *
       * AuthContext writes it only for accounts that actually have a
       * password, since those are the only ones that can use
       * username-and-password login; a Google-only account never has its
       * address copied here.
       *
       * The tradeoff is real: anyone who knows an exact username can read
       * the address behind it. list stays closed, so addresses cannot be
       * harvested in bulk, but usernames on the public leaderboard are
       * effectively public. Resolving this privately needs a server-side
       * lookup, which this project deliberately does not have.
       */
      allow create: if signedIn()
        && notSuspended(request.auth.uid)
        && validUsername(username)
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid
        && (
          !request.resource.data.keys().hasAny(['email'])
          || (
            request.resource.data.email is string
            && request.resource.data.email.size() <= 320
          )
        );

      allow delete: if signedIn()
        && notSuspended(request.auth.uid)
        && resource.data.uid == request.auth.uid;

      // Only ever to attach or refresh the owner's own login email. The
      // uid is pinned, so an update can never transfer a username.
      allow update: if signedIn()
        && notSuspended(request.auth.uid)
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320;
    }

    // Public ScienceGlimpse Summit leaderboard. A denormalized copy of each
    // player's username + best altitude (src/hooks/useBestAltitude.ts).
    // users/{uid} is private (see above), so this is the only place a
    // username is ever exposed publicly — deliberately minimal (no
    // photo, no uid in the document body) since anyone, signed in or
    // not, can read it.
    //
    // Players publish their own entry. Moderators can also publish one
    // for anybody (the Admin dashboard's "Sync leaderboard" button, which
    // backfills records set before this collection existed). The
    // getAfter() check applies to BOTH: an entry must match that
    // player's real gameStats altitude, so not even a moderator can
    // invent a score — they can only publish a genuine one.
    match /leaderboard/{userId} {
      allow get, list: if true;

      allow create, update: if (isOwner(userId) || isModerator())
        && notSuspended(userId)
        && request.resource.data.keys().hasOnly([
          'username',
          'bestAltitude',
          'updatedAt'
        ])
        && validUsername(request.resource.data.username)
        && request.resource.data.bestAltitude is int
        && request.resource.data.bestAltitude >= 0
        && request.resource.data.updatedAt == request.time
        && request.resource.data.bestAltitude == getAfter(
          /databases/$(database)/documents/users/$(userId)/gameStats/scienceSummit
        ).data.bestAltitude;

      // Moderators remove a player's entry when suspending them; the
      // dashboard republishes it (through the rule above) on restore.
      allow delete: if isModerator();
    }

    // In-progress ScienceGlimpse Summit run, so a player can pause, close the
    // tab, and pick the same climb back up later instead of restarting
    // from the ground (src/games/.../ScienceSummit.tsx). Cleared by the
    // client the moment a run actually ends (lava or falling out of
    // tokens), so a saved doc existing at all means "still climbing."
    // Private — nobody but the player themselves needs this.
    match /users/{userId}/gameRuns/{runId} {
      allow get, list: if isOwner(userId);

      allow create, update: if isOwner(userId)
        && notSuspended(userId)
        && request.resource.data.keys().hasOnly([
          'altitude',
          'checkpointX',
          'checkpointY',
          'maxHeight',
          'updatedAt'
        ])
        && request.resource.data.altitude is int
        && request.resource.data.altitude >= 0
        && request.resource.data.checkpointX is number
        && request.resource.data.checkpointY is number
        && request.resource.data.maxHeight is int
        && request.resource.data.maxHeight >= 0
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(userId);
    }

    match /users/{userId}/readingProgress/{articleId} {
      allow get, list: if isOwner(userId);

      allow create: if isOwner(userId)
        && notSuspended(userId)
        && emailVerified()
        && validArticleId(articleId)
        && validProgress(request.resource.data, articleId)
        && request.resource.data.activeSeconds == 15
        && request.resource.data.rewarded == false
        && request.resource.data.rewardedAt == null
        && request.resource.data.lastHeartbeatAt == request.time;

      // Checked on update as well as create: without it, reads invented
      // while the bound was missing could still be driven to payout.
      allow update: if isOwner(userId)
        && notSuspended(userId)
        && emailVerified()
        && validArticleId(articleId)
        && validProgress(request.resource.data, articleId)
        && resource.data.rewarded == false
        && request.resource.data.articleId
          == resource.data.articleId
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'activeSeconds',
            'rewarded',
            'lastHeartbeatAt',
            'rewardedAt'
          ])
        && request.resource.data.activeSeconds
          == resource.data.activeSeconds + 15
        && request.resource.data.lastHeartbeatAt
          == request.time
        && request.time
          >= resource.data.lastHeartbeatAt
            + duration.value(15, 's')
        && (
          (
            request.resource.data.activeSeconds < 240
            && request.resource.data.rewarded == false
            && request.resource.data.rewardedAt == null
          )
          ||
          (
            request.resource.data.activeSeconds == 240
            && request.resource.data.rewarded == true
            && request.resource.data.rewardedAt
              == request.time
            && claimsRewardCooldown(userId, articleId)
            && getAfter(
              /databases/$(database)/documents/users/$(userId)/tokenLedger/$(articleId)
            ).data.amount == 10
          )
        );

      allow delete: if false;
    }

    // When this account last earned an article reward — see
    // claimsRewardCooldown above. Restamped by every reward, never
    // deleted: deleting it would reset the clock.
    match /users/{userId}/rewardCooldown/{cooldownId} {
      allow get: if isOwner(userId);

      allow create: if isOwner(userId)
        && notSuspended(userId)
        && cooldownId == 'latest'
        && validRewardCooldown(request.resource.data);

      allow update: if isOwner(userId)
        && notSuspended(userId)
        && validRewardCooldown(request.resource.data)
        && request.time
          >= resource.data.rewardedAt + duration.value(180, 's');

      allow delete: if false;
    }

    match /users/{userId}/tokenLedger/{articleId} {
      allow get, list: if isOwner(userId)
        || isModerator();

      // One-off welcome balance for a new account, written by
      // AuthContext the first time a profile is created. The fixed
      // document ID is the safeguard: create is allowed but update and
      // delete never are (below), so 'signup_bonus' can exist at most
      // once per account and is worth exactly 30.
      //
      // Keep the 30 here in step with SIGNUP_BONUS_TOKENS in
      // src/context/AuthContext.tsx.
      allow create: if isOwner(userId)
        && notSuspended(userId)
        && emailVerified()
        && articleId == 'signup_bonus'
        && request.resource.data.keys().hasOnly([
          'amount',
          'type',
          'createdAt'
        ])
        && request.resource.data.amount == 30
        && request.resource.data.type == 'signup_bonus'
        && request.resource.data.createdAt == request.time;

      // Article-reading reward. A second allow for the same operation is
      // OR'd with the one above.
      allow create: if isOwner(userId)
        && notSuspended(userId)
        && emailVerified()
        && validArticleId(articleId)
        && claimsRewardCooldown(userId, articleId)
        && request.resource.data.keys().hasAll([
          'articleId',
          'amount',
          'type',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'articleId',
          'amount',
          'type',
          'createdAt'
        ])
        && request.resource.data.articleId == articleId
        && request.resource.data.amount == 10
        && request.resource.data.type == 'article_read'
        && request.resource.data.createdAt == request.time
        && getAfter(
          /databases/$(database)/documents/users/$(userId)/readingProgress/$(articleId)
        ).data.activeSeconds == 240
        && getAfter(
          /databases/$(database)/documents/users/$(userId)/readingProgress/$(articleId)
        ).data.rewarded == true
        && getAfter(
          /databases/$(database)/documents/users/$(userId)/readingProgress/$(articleId)
        ).data.rewardedAt == request.time;

      allow update, delete: if false;
    }

    match /users/{userId}/tokenAdjustments/{adjustmentId} {
      allow get, list: if isOwner(userId)
        || isModerator();

      allow create: if isModerator()
        && request.resource.data.keys().hasAll([
          'amount',
          'reason',
          'moderatorUid',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'amount',
          'reason',
          'moderatorUid',
          'createdAt'
        ])
        && request.resource.data.amount is int
        && request.resource.data.amount != 0
        && request.resource.data.amount >= -1000
        && request.resource.data.amount <= 1000
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3
        && request.resource.data.reason.size() <= 200
        && request.resource.data.moderatorUid
          == request.auth.uid
        && request.resource.data.createdAt
          == request.time;

      // Preserve a permanent audit history.
      allow update, delete: if false;
    }

    // ScienceGlimpse Summit game energy ledger. Entries are immutable, exactly
    // like tokenLedger above, and count toward a player's real token
    // balance (see src/lib/tokens.ts, which sums tokenLedger +
    // tokenAdjustments + gameLedger).
    //
    // Jumping is the only thing that spends energy in this game (there
    // is no in-game way to earn tokens back), so every entry is a fixed
    // -1 charge for every 10 jumps. A negative amount only ever costs
    // the player their own tokens, so this doesn't need the getAfter()
    // cross-document validation tokenLedger uses above — there's no
    // positive-amount case here to guard against.
    match /users/{userId}/gameLedger/{entryId} {
      allow get, list: if isOwner(userId)
        || isModerator();

      allow create: if isOwner(userId)
        && notSuspended(userId)
        && request.resource.data.keys().hasOnly([
          'amount',
          'type',
          'createdAt'
        ])
        && request.resource.data.amount == -1
        && request.resource.data.type == 'game_jump_batch'
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // ScienceGlimpse Summit best-altitude record, scoped to the account
    // (src/hooks/useBestAltitude.ts). Purely a vanity stat with no
    // currency behind it, so this only needs light shape validation —
    // unlike the token collections above, there's nothing to protect
    // against here beyond malformed data.
    match /users/{userId}/gameStats/{statId} {
      allow get, list: if isOwner(userId)
        || isModerator();

      allow create, update: if isOwner(userId)
        && notSuspended(userId)
        && request.resource.data.keys().hasOnly([
          'bestAltitude',
          'updatedAt'
        ])
        && request.resource.data.bestAltitude is int
        && request.resource.data.bestAltitude >= 0
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    /*
     * Articles live in Firestore so the Admin dashboard and Submission
     * flow can manage them instead of hand-editing a JSON file. The public
     * site and the build-time snapshot read only published articles; drafts
     * stay private to moderators and the person who submitted them.
     *
     * A document's ID is its slug. Writers cannot self-publish: a submitter
     * may only create/edit their own drafts, and only a moderator may set
     * status to 'published' or edit a live article.
     */
    function validArticle(a) {
      return a.keys().hasAll([
          'slug', 'title', 'excerpt', 'content',
          'category', 'author', 'status', 'createdBy'
        ])
        && a.slug is string
        && a.title is string && a.title.size() > 0 && a.title.size() <= 200
        && a.excerpt is string && a.excerpt.size() <= 500
        && a.content is string && a.content.size() <= 900000
        && a.category is list
        && a.author is string
        && a.status in ['draft', 'in_review', 'published']
        && a.createdBy is string;
    }

    match /articles/{slug} {
      // Published articles are world-readable (the site is public and
      // prerendered); moderators and the submitter can see their drafts.
      allow get: if resource.data.status == 'published'
        || isModerator()
        || (signedIn() && resource.data.createdBy == request.auth.uid);

      // Public queries must stay within published articles; moderators may
      // list everything so the dashboard can show drafts awaiting review.
      allow list: if isModerator()
        || (request.query.limit <= 1000
            && resource.data.status == 'published');

      // A verified signed-in user may submit a draft under their own uid;
      // a moderator may create an already-published article directly.
      allow create: if validArticle(request.resource.data)
        && request.resource.data.slug == slug
        && (
          (signedIn() && emailVerified() && notSuspended(request.auth.uid)
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.status in ['draft', 'in_review'])
          || isModerator()
        );

      // Submitters may edit their own drafts but cannot publish or reassign
      // ownership; moderators may edit anything, including publishing.
      allow update: if validArticle(request.resource.data)
        && request.resource.data.slug == slug
        && (
          isModerator()
          || (signedIn()
            && resource.data.createdBy == request.auth.uid
            && request.resource.data.createdBy == resource.data.createdBy
            && resource.data.status != 'published'
            && request.resource.data.status in ['draft', 'in_review'])
        );

      // Only moderators can delete, so published history can't vanish by
      // accident from a submitter's account.
      allow delete: if isModerator();
    }
  }
}
